<Project Sdk="Microsoft.NET.Sdk">

  <!-- The phone page: a small Kestrel server on the local network with a WebSocket live feed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LockIn.Remote</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LockIn.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LockIn.Core\LockIn.Core.csproj" />
  </ItemGroup>

</Project>
