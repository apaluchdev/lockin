<UserControl x:Class="LockIn.App.Views.LoadoutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LockIn.App.ViewModels"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance Type=vm:LoadoutsViewModel}">
    <DockPanel Margin="4,12,4,4">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox Width="200" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                          ItemsSource="{Binding AllChampions}" SelectedItem="{Binding ChampionToAdd}"
                          DisplayMemberPath="Name" ToolTip="Add a champion that isn't on your pick lists" />
                <Button Content="Add" Command="{Binding AddChampionCommand}" Margin="8,0,0,0" />
                <Button Content="Reload rune pages" Command="{Binding RefreshRunePagesCommand}" Margin="8,0,0,0"
                        IsEnabled="{Binding IsClientConnected}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Runes &amp; summoner spells" Style="{StaticResource CardTitle}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="When one of these champions is locked in (by LockIn or by you), LockIn switches to its rune page and sets its spells. Champions on your pick lists appear here automatically." />
                <TextBlock Text="{Binding RunePageStatus}" Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </DockPanel>

        <!-- Column headings -->
        <Grid DockPanel.Dock="Top" Margin="12,0,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="175" />
                <ColumnDefinition Width="175" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Champion" Style="{StaticResource Hint}" />
            <TextBlock Grid.Column="1" Text="Rune page" Style="{StaticResource Hint}" Margin="8,0" />
            <TextBlock Grid.Column="2" Text="Spell on D" Style="{StaticResource Hint}" Margin="8,0" />
            <TextBlock Grid.Column="3" Text="Spell on F" Style="{StaticResource Hint}" Margin="8,0" />
        </Grid>

        <Border Style="{StaticResource Card}" Padding="4" Margin="0">
            <Grid>
                <ListBox ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LoadoutRowViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="175" />
                                    <ColumnDefinition Width="175" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter Content="{Binding Champion}" ContentTemplate="{StaticResource ChampionIcon}" />
                                    <TextBlock Text="{Binding Champion.Name}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="14" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Margin="8,0"
                                          ItemsSource="{Binding DataContext.RunePages, ElementName=Root}"
                                          SelectedItem="{Binding RunePage}" DisplayMemberPath="Display" />
                                <ComboBox Grid.Column="2" Margin="8,0"
                                          ItemsSource="{Binding DataContext.Spells, ElementName=Root}"
                                          SelectedItem="{Binding Spell1}" DisplayMemberPath="Name" />
                                <ComboBox Grid.Column="3" Margin="8,0"
                                          ItemsSource="{Binding DataContext.Spells, ElementName=Root}"
                                          SelectedItem="{Binding Spell2}" DisplayMemberPath="Name" />
                                <Button Grid.Column="4" Content="&#xE711;" ToolTip="Clear this champion's runes and spells"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Padding="6,2" MinWidth="0"
                                        Command="{Binding DataContext.ClearRowCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Add champions to your pick lists (or use Add above) to set their runes and spells."
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
