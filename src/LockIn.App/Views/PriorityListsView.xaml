<UserControl x:Class="LockIn.App.Views.PriorityListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LockIn.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PriorityListsViewModel}">
    <UserControl.Resources>
        <Style x:Key="CompactItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="4,12,4,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" MinWidth="260" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- Roles -->
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="Role" Style="{StaticResource CardTitle}" />
            <ListBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                     ItemContainerStyle="{StaticResource CompactItem}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RoleListViewModel}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding Title}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- The priority list -->
        <DockPanel Grid.Column="1" Margin="0,0,12,0">
            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardTitle}">
                    <Run Text="{Binding SelectedRole.Title, Mode=OneWay}" />
                    <Run Text="—" />
                    <Run Text="{Binding Heading, Mode=OneWay}" />
                </TextBlock>
                <Button DockPanel.Dock="Right" Content="Clear list" Command="{Binding ClearListCommand}" VerticalAlignment="Top" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Explanation}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0"
                       Text="Drag to reorder. Add champions from the list on the right (double-click, Enter, or drag)." />

            <Border Style="{StaticResource Card}" Padding="4" Margin="0">
                <Grid>
                    <ListBox x:Name="PriorityList" ItemsSource="{Binding SelectedRole.Items}"
                             ItemContainerStyle="{StaticResource CompactItem}"
                             Background="Transparent" BorderThickness="0" AllowDrop="True"
                             PreviewMouseLeftButtonDown="OnPriorityMouseDown" PreviewMouseMove="OnPriorityMouseMove"
                             DragOver="OnPriorityDragOver" Drop="OnPriorityDrop">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RankedChampion}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Rank}" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ContentPresenter Grid.Column="1" Content="{Binding Champion}" ContentTemplate="{StaticResource ChampionIcon}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Champion.Name}" FontSize="14" />
                                        <Border x:Name="NotOwned" Visibility="Collapsed" Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                                            <TextBlock Text="not owned" FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Move up"
                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Move down"
                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remove"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Champion.IsPlayable}" Value="False" />
                                            <Condition Binding="{Binding DataContext.IsPicks, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="NotOwned" Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No champions yet — add some from the list on the right."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRole.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Champion picker -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Add champions" Style="{StaticResource CardTitle}" />
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnSearchKeyDown" ToolTip="Type to filter, Enter to add the highlighted champion" />
            <Button DockPanel.Dock="Bottom" Content="Add to list" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                    Command="{Binding AddCommand}" />
            <ListBox x:Name="AvailableList" ItemsSource="{Binding Available}" SelectedItem="{Binding SelectedAvailable}"
                     ItemContainerStyle="{StaticResource CompactItem}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                     MouseDoubleClick="OnAvailableDoubleClick"
                     PreviewMouseLeftButtonDown="OnAvailableMouseDown" PreviewMouseMove="OnAvailableMouseMove">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChampionItemViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ChampionIcon}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
