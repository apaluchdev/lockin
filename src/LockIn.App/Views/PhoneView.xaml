<UserControl x:Class="LockIn.App.Views.PhoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LockIn.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PhoneViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="4,12,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Settings -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Phone" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="Follow champ select live on your phone and change your pick or ban from it. Your phone has to be on the same Wi-Fi as this PC; nothing goes over the internet." />
                        <CheckBox Content="Let my phone connect" IsChecked="{Binding Enabled}" FontSize="14" />
                        <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Connection" Style="{StaticResource CardTitle}" />
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Port" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Change it only if something else already uses this port." Style="{StaticResource Hint}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="90" Margin="16,0,0,0" VerticalAlignment="Center" HorizontalContentAlignment="Right"
                                     Text="{Binding Port, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                        <Grid Margin="0,10,0,4" Visibility="{Binding HasSeveralAddresses, Converter={StaticResource BoolToVisible}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Network address" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="This PC has several. Use the one on the same network as your phone (usually 192.168.x.x)." Style="{StaticResource Hint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="160" Margin="16,0,0,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding Addresses}" SelectedItem="{Binding SelectedAddress}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Refresh addresses" Command="{Binding RefreshAddressesCommand}" />
                            <Button Content="Sign out all phones" Command="{Binding SignOutPhonesCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="If your phone can't connect" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Hint}" FontSize="13">
                            <Run Text="• When Windows asks whether to allow LockIn on the network, allow it on" /><Run Text=" private networks" FontWeight="SemiBold" /><Run Text=" (not public)." />
                            <LineBreak />
                            <Run Text="• If you dismissed that prompt, allow LockIn in Windows Security → Firewall &amp; network protection → Allow an app through firewall." />
                            <LineBreak />
                            <Run Text="• Make sure your phone is on the same Wi-Fi, not mobile data or a guest network." />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- QR code -->
            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top" Width="300">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Scan with your phone" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" />
                    <Grid Width="240" Height="240" Margin="0,4,0,8">
                        <Border Background="White" CornerRadius="8" Padding="6"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisible}}">
                            <Image Source="{Binding QrCode}" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   AutomationProperties.Name="QR code linking to the phone page" />
                        </Border>
                        <Border CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                Visibility="{Binding QrCode, Converter={StaticResource NullToVisible}}">
                            <TextBlock Text="Turn on phone access to get a QR code" Style="{StaticResource Hint}"
                                       TextAlignment="Center" VerticalAlignment="Center" Margin="24" />
                        </Border>
                    </Grid>
                    <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="Or open this address on your phone:" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                        <TextBox Text="{Binding Address, Mode=OneWay}" IsReadOnly="True" HorizontalContentAlignment="Center"
                                 FontSize="14" Margin="0,4,0,10" />
                        <TextBlock Text="and enter the pairing code" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PairingCode}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   FontFamily="Cascadia Mono, Consolas" Margin="0,2,0,10" />
                        <Button Content="Copy link (includes the key)" Command="{Binding CopyLinkCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
