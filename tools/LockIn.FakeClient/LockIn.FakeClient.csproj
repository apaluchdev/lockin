<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A pretend League client for trying LockIn without playing: it serves the client API on
    loopback and plays out a scripted ranked champ select. See README.md in this folder.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LockIn.FakeClient</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the tests so both exercise the same fake. -->
    <Compile Include="..\..\tests\LockIn.Core.Tests\Fakes\FakeLeagueClient.cs" Link="FakeLeagueClient.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LockIn.Core\LockIn.Core.csproj" />
  </ItemGroup>

</Project>
